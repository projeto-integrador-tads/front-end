{
  "expo": {
    "name": "VemComigo",
    "slug": "vem-comigo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/images/icon.png",
    "newArchEnabled": true,
    "developmentClient": {
      "silentLogs": true
    },
    "ios": {
      "supportsTablet": true,
      "allowScreenCapture": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logo.png",
        "backgroundColor": "#0077b6"
      },
      "package": "com.anonymous.VemComigo",
      "allowScreenCapture": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo.png",
          "imageWidth": 150,
          "resizeMode": "native",
          "backgroundColor": "#0077b6"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d6475886-60b8-41d8-a44d-b64eb57281c5"
      }
    },
    "owner": "afraniomcaires"
  }
}
